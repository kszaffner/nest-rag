# Which LLM backend to use for generation: mock | claude | ollama
# "mock" needs no API key at all - safe default while developing (zero cost).
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Only needed when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

PORT=3000

# Embeddings: mock (free, no meaning) | transformers (real local model)
EMBEDDING_PROVIDER=mock
# true = never download the model, fail if it is not already cached
EMBEDDING_LOCAL_FILES_ONLY=false
# Optional: pin the model to an exact commit of its Hugging Face repository
EMBEDDING_MODEL_REVISION=

# LLM: mock (free, canned answers) | ollama (local model) | claude (paid API)
LLM_PROVIDER=mock
# Used only when LLM_PROVIDER=claude. Never commit a real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# false = Ollama must run on this computer; true = allow another machine
OLLAMA_ALLOW_NON_LOCAL_HOST=false

VECTOR_STORE=memory

SQLITE_DATABASE_PATH=data/index.sqlite